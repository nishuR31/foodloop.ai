# ==========================================
# FoodLoop AI - Root Git Ignore Configuration
# ==========================================

# ------------------------------------------
# All Hidden Dotfiles & Directories
# (AI agents, editor state, OS cache, local envs)
# ------------------------------------------
.*
.*/
*/.*
*/.*/
*/**/.*
*/**/.*/

# Whitelist essential repository configuration files
!.gitignore
!**/.gitignore
!.dockerignore
!**/.dockerignore
!.env.example
!**/.env.example

# ------------------------------------------
# Environment & Sensitive Credentials
# ------------------------------------------
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.cert
cookies.txt

# ------------------------------------------
# Dependencies & Package Managers
# ------------------------------------------
node_modules/
*/node_modules/
backend/node_modules/
frontend/node_modules/
.pnp/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ------------------------------------------
# Frontend & Next.js Builds
# ------------------------------------------
.next/
*/.next/
frontend/.next/
out/
*/out/
frontend/out/
build/
*/build/

# ------------------------------------------
# Backend Build & Prisma Generated Files
# ------------------------------------------
dist/
*/dist/
backend/dist/
backend/prisma/seed.js
backend/prisma/seed.js.map
backend/prisma/seed.d.ts
backend/prisma/seed.d.ts.map

# ------------------------------------------
# Python / OCR Cache & Virtualenvs
# ------------------------------------------
__pycache__/
*/__pycache__/
*/**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
*/.venv/
venv/
*/venv/
env/
*/env/
ENV/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/

# ------------------------------------------
# Executables & Binaries
# ------------------------------------------
*.exe
*.bin
*.dll
frontend/bin/
frontend/bin/arduino-cli.exe

# ------------------------------------------
# Logs & Debugging
# ------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------
# Testing & Coverage
# ------------------------------------------
coverage/
*/coverage/
.nyc_output/

# ------------------------------------------
# TypeScript
# ------------------------------------------
*.tsbuildinfo
