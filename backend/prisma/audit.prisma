generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/audit-client"
}

datasource db {
  provider = "postgresql"
  url      = env("AUDIT_DATABASE_URL")
}

model AuditLog {
  id             String   @id @default(uuid())
  entityId       String
  entityType     String
  action         String
  actorId        String?
  details        String?
  blockchainHash String
  createdAt      DateTime @default(now())
}
